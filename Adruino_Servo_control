#include <Servo.h>

Servo diskServo;

const int SERVO_PIN = 9;
const int MIN_PULSE = 600;
const int MAX_PULSE = 2400;

const float STEP_ANGLE = 22.5;
const int MOVES_PER_REP = 16;

int currentStep = 0;
int direction = 1;
int currentPulse = MIN_PULSE;
int moveCount = 0;

bool running = true;

int angleToPulse(float angle) {
  return MIN_PULSE +
         round((angle / 180.0) * (MAX_PULSE - MIN_PULSE));
}

void checkStopCommand() {
  if (Serial.available()) {
    char command = Serial.read();

    if (command == 's') {
      running = false;
      Serial.println("Stopped manually");
    }
  }
}

void moveSmoothly(float targetAngle) {
  int targetPulse = angleToPulse(targetAngle);

  if (targetPulse > currentPulse) {
    for (int pulse = currentPulse; pulse <= targetPulse; pulse += 4) {
      checkStopCommand();

      if (!running) {
        currentPulse = pulse;
        diskServo.writeMicroseconds(currentPulse);
        return;
      }

      diskServo.writeMicroseconds(pulse);
      delay(12);
    }
  } else {
    for (int pulse = currentPulse; pulse >= targetPulse; pulse -= 4) {
      checkStopCommand();

      if (!running) {
        currentPulse = pulse;
        diskServo.writeMicroseconds(currentPulse);
        return;
      }

      diskServo.writeMicroseconds(pulse);
      delay(12);
    }
  }

  currentPulse = targetPulse;
  diskServo.writeMicroseconds(currentPulse);
}

void startNewRepetition() {
  running = false;

  // Return to the starting position first.
  moveSmoothly(0);

  currentStep = 0;
  direction = 1;
  moveCount = 0;
  running = true;

  Serial.println();
  Serial.println("Starting one repetition...");
}

void setup() {
  Serial.begin(9600);

  diskServo.attach(SERVO_PIN);
  diskServo.writeMicroseconds(currentPulse);

  Serial.println("Commands:");
  Serial.println("s = stop");
  Serial.println("r = start a new 16-move repetition");
  Serial.println("h = stop and return home");

  delay(1000);
  startNewRepetition();
}

void loop() {
  if (Serial.available()) {
    char command = Serial.read();

    if (command == 's') {
      running = false;
      Serial.println("Stopped manually");
    }

    if (command == 'r') {
      startNewRepetition();
    }

    if (command == 'h') {
      running = false;
      moveSmoothly(0);

      currentStep = 0;
      direction = 1;
      moveCount = 0;

      Serial.println("Stopped at home position");
    }
  }

  if (!running) {
    return;
  }

  currentStep += direction;

  if (currentStep >= 8) {
    currentStep = 8;
    direction = -1;
  } else if (currentStep <= 0) {
    currentStep = 0;
    direction = 1;
  }

  float targetAngle = currentStep * STEP_ANGLE;
  moveSmoothly(targetAngle);

  if (!running) {
    return;
  }

  moveCount++;

  Serial.print("Count: ");
  Serial.print(moveCount);
  Serial.print("/16 | Servo angle: ");
  Serial.print(targetAngle);
  Serial.println(" degrees");

  if (moveCount >= MOVES_PER_REP) {
    running = false;
    Serial.println("One repetition completed. Motor stopped.");
    Serial.println("Send r to run again.");
    return;
  }

  delay(1500);
}
